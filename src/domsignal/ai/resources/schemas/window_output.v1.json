        "subtype": {
          "enum": [
            "gas.smell",
            "gas.supply_outage",
            "elevator.button",
            "elevator.doors",
            "elevator.stopped",
            "roof.leak",
            "water.leak",
            "water.hot_outage",
            "water.supply_outage",
            "water.quality",
            "water.pressure",
            "heating.cold_radiators",
            "electrical.panel",
            "power.grid_outage",
            "street_lighting.failure",
            "lighting.yard",
            "lighting.stairwell",
            "waste.chute",
            "waste.container_site",
            "waste.removal_regional",
            "intercom.broken",
            "entrance_door.broken",
            "cleaning.stairwell",
            "snow.street",
            "snow.yard",
            "playground.damaged",
            "landscaping.public",
            "road.damage",
            "structure.damage",
            "external_network.outage",
            "other.unspecified"
          ],
          "title": "Subtype",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
