          "default": null,
          "title": "Msg"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "value": {
          "enum": [
            "apartment",
            "house_common",
            "house_territory",
            "municipal_territory",
            "external_network",
            "other_building",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ModelScope",
      "type": "object"
    },
    "ModelSignal": {
      "additionalProperties": false,
      "properties": {
        "clean_description": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "danger": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelDanger"
          },
          "maxItems": 8,
          "title": "Danger",
          "type": "array"
        },
        "danger_refutation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRefutation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entrance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facets": {
          "$ref": "#/$defs/ModelFacets"
        },
        "floor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
