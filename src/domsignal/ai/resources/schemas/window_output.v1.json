{
  "$defs": {
    "ModelDanger": {
      "additionalProperties": false,
      "properties": {
        "contextual": {
          "default": false,
          "title": "Contextual",
          "type": "boolean"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelEvidence"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "gas",
            "smoke_fire",
            "electric",
            "person_trapped",
            "flooding",
            "structural",
            "other_hazard"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ModelDanger",
      "type": "object"
    },
    "ModelEvidence": {
      "additionalProperties": false,
      "properties": {
        "msg": {
          "description": "Идентификатор реплики окна, например m3",
          "title": "Msg",
          "type": "string"
        },
        "quote": {
          "description": "Дословная цитата из этой реплики",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "msg",
        "quote"
      ],
      "title": "ModelEvidence",
      "type": "object"
    },
    "ModelFacet": {
      "additionalProperties": false,
      "properties": {
        "msg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Msg"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "v": {
          "enum": [
            "yes",
            "no",
            "unclear"
          ],
          "title": "V",
          "type": "string"
        }
      },
      "required": [
        "v"
      ],
      "title": "ModelFacet",
      "type": "object"
    },
    "ModelFacets": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "#/$defs/ModelFacet"
        },
        "local": {
          "$ref": "#/$defs/ModelFacet"
        },
        "observed": {
          "$ref": "#/$defs/ModelFacet"
        }
      },
      "required": [
        "current",
        "local",
        "observed"
      ],
      "title": "ModelFacets",
      "type": "object"
    },
    "ModelLine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "link_certainty": {
          "anyOf": [
            {
              "enum": [
                "sure",
                "unsure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Certainty"
        },
        "role": {
          "enum": [
            "new_problem",
            "me_too",
            "more_info",
            "objection",
            "status_question",
            "resolved_claim",
            "announcement",
            "discussion",
            "chatter",
            "out_of_scope"
