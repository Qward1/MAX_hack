      "default": [],
      "items": {
        "$ref": "#/$defs/ModelLine"
      },
      "maxItems": 45,
      "title": "Messages",
      "type": "array"
    },
    "signals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelSignal"
      },
      "maxItems": 5,
      "title": "Signals",
      "type": "array"
    }
  },
  "title": "window_output.v1",
  "type": "object"
}
