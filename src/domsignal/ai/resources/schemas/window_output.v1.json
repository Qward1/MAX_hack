      "required": [
        "ref",
        "subtype",
        "object",
        "location_scope",
        "facets"
      ],
      "title": "ModelSignal",
      "type": "object"
    },
    "ModelText": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Sources",
          "type": "array"
        },
        "text": {
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ModelText",
      "type": "object"
    },
    "ModelValue": {
      "additionalProperties": false,
      "properties": {
        "msg": {
          "title": "Msg",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "quote",
        "msg"
      ],
      "title": "ModelValue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ответ модели на одно окно.",
  "properties": {
