        "signals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role"
      ],
      "title": "ModelLine",
      "type": "object"
    },
    "ModelRefutation": {
      "additionalProperties": false,
      "properties": {
        "msg": {
          "title": "Msg",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "enum": [
            "past",
            "resolved",
            "other_place",
            "explicit_negation",
            "not_literal"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "quote",
        "msg"
      ],
      "title": "ModelRefutation",
      "type": "object"
    },
    "ModelScope": {
      "additionalProperties": false,
      "properties": {
        "msg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
