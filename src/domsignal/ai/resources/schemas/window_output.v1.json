        "location_scope": {
          "$ref": "#/$defs/ModelScope"
        },
        "object": {
          "maxLength": 120,
          "title": "Object",
          "type": "string"
        },
        "ref": {
          "description": "new:N для новой проблемы или open:K открытого элемента",
