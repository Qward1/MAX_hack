APP_ENV=local
DATABASE_URL=postgresql+asyncpg://domsignal:domsignal@localhost:5432/domsignal
SESSION_SECRET=local-only-change-me
ALLOW_TEST_SESSION=true
DEMO_SEED=true
MAX_TRANSPORT=off
MAX_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT_SECONDS=5
MAX_REQUIRED_PERMISSIONS=["read_all_messages"]
CHAT_CONNECTION_TTL_SECONDS=900
LLM_PROVIDER=rules
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_SCHEMA_MODE=json_schema_strict
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=1600
LLM_MAX_CONCURRENCY=4
LLM_DAILY_CALL_BUDGET=1000
LLM_CHAT_DAILY_SHARE=0.2
# Пассивное чтение подключённого чата: выключено, пока не включено явно.
PASSIVE_CAPTURE_ENABLED=false
# Политика окна ядра; на демо-стенде тишина 20 секунд, 120 ждать нельзя.
PASSIVE_WINDOW_SILENCE_SECONDS=120
PASSIVE_WINDOW_MAX_LINES=10
PASSIVE_WINDOW_MAX_AGE_SECONDS=300
PASSIVE_WEAK_DAILY_LIMIT=10
PASSIVE_DEDUPE_DAYS=7
# Срок жизни сырых реплик, не больше 72 часов.
PASSIVE_BUFFER_HOURS=72
# Повтор сообщения об опасности того же вида в доме за это время
# присоединяется к открытому сигналу; памятка в чат не чаще раза за паузу.
PASSIVE_DANGER_GROUP_MINUTES=30
PASSIVE_CHAT_MEMO_PAUSE_MINUTES=30
# Сторож разбора окна: остановленный AI-пул задерживает сигналы не дольше.
PASSIVE_ANALYSIS_FALLBACK_SECONDS=90
BUILD_COMMIT=dev
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
