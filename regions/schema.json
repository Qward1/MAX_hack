{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domsignal.local/schemas/region-pack-v1.json",
  "title": "DomSignal region pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "region", "version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "pack_id": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "verification_status", "source", "due_at", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["elevator", "water", "lighting", "waste", "other"]},
          "verification_status": {"enum": ["verified", "needs_verification", "demo"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"}
            }
          },
          "due_at": {"type": "null"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
