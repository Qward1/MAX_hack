# Copy to deploy/.env.production on the VPS and chmod 600.
# Generate the three non-token values with the commands in deploy/README.md.
PUBLIC_DOMAIN=bot.example.com
POSTGRES_PASSWORD=replace_with_64_hex_characters
SESSION_SECRET=replace_with_at_least_64_random_characters
MAX_BOT_TOKEN=replace_with_issued_max_token
MAX_WEBHOOK_SECRET=replace_with_64_hex_characters
AUTH_MFA_ENCRYPTION_KEY=generate_once_on_server_with_Fernet

# Модель — только для ai-worker (compose.prod.yaml). По умолчанию правила без
# ключа; ключ создаётся у провайдера и дописывается только на VPS.
# M1: провайдер — Cloud.ru Evolution Foundation Models, модель Qwen/Qwen3-30B-A3B.
LLM_PROVIDER=rules
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
LLM_MODEL=
# Пусто — таймаут из профиля модели (models.v1.yaml); число перекрывает профиль.
LLM_TIMEOUT_SECONDS=
LLM_DAILY_CALL_BUDGET=300
AI_WORKER_LEASE_SECONDS=80

# Пассивное чтение подключённого чата: глобальный выключатель и тишина окна.
PASSIVE_CAPTURE_ENABLED=false
PASSIVE_LLM_ENABLED=true
PASSIVE_WINDOW_SILENCE_SECONDS=120
# Окно не длиннее 6 реплик (OWNER-DECISION-2026-09-24).
PASSIVE_WINDOW_MAX_LINES=6

# D3: через сколько дней после «Я отправил» бот спросит, пришёл ли ответ;
# час ежедневной сводки сотрудникам (МСК); ночное окно личных рассылок
# жителям (00:00-00:00 — без окна).
APPEAL_FOLLOWUP_DAYS=14
DAILY_DIGEST_HOUR_MSK=9
BROADCAST_DM_QUIET_HOURS=22:00-08:00
